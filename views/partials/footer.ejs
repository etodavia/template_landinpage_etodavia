<footer>
    <div class="container">
        <div class="footer-main">
            <div class="footer-column">
                <a href="/" class="footer-logo">
                    <% if (settings.logo_white) { %>
                        <img src="<%= settings.logo_white %>" alt="<%= settings.site_name || 'Empresa' %>" style="max-height: 40px;">
                    <% } else if (settings.logo) { %>
                        <img src="<%= settings.logo %>" alt="<%= settings.site_name || 'Empresa' %>" style="max-height: 40px;">
                    <% } else { %>
                        Sistema
                    <% } %>
                </a>
                <p style="opacity: 0.78; font-size: 0.85rem; margin-top: 1rem; max-width: 280px; line-height: 1.6;">
                    <%= settings.footer_short_text || 'Liderando a transformação estratégica através do capital humano e performance operacional de alto nível.' %>
                </p>
                <% if (settings.footer_secure_link) { %>
                    <a href="<%= settings.footer_secure_link %>" target="_blank" class="safe-site-badge" style="text-decoration: none; color: inherit;">
                        <i class="ri-shield-check-line"></i> SITE 100% SEGURO
                    </a>
                <% } else { %>
                    <div class="safe-site-badge">
                        <i class="ri-shield-check-line"></i> SITE 100% SEGURO
                    </div>
                <% } %>
            </div>

            <div class="footer-column footer-links">
                <h4>Navegação</h4>
                <% 
                   let fmenu1 = [
                       { label: 'Home', link: '/#home' },
                       { label: 'Sobre', link: '/#sobre' },
                       { label: 'Serviços', link: '/#servicos' },
                       { label: 'Campanhas', link: '/#campanhas' },
                       { label: 'Contato', link: '/#contato' }
                   ];
                   if (settings.footer_menu_1 && settings.footer_menu_1.trim() !== '') {
                       fmenu1 = settings.footer_menu_1.split('\n').filter(line => line.includes('|')).map(line => {
                           const [label, link] = line.split('|');
                           return { label: label.trim(), link: link.trim() };
                       });
                   }
                %>
                <ul>
                    <% fmenu1.forEach(item => { %>
                    <li><a href="<%= item.link %>"><%= item.label %></a></li>
                    <% }); %>
                    <li><a href="/admin/login" style="opacity: 0.8; margin-top: 10px; display: inline-block;">Área Administrativa (Login)</a></li>
                </ul>
            </div>

            <div class="footer-column footer-links">
                <h4>Jurídico</h4>
                <% 
                   let fmenu2 = [
                       { label: 'Política de Privacidade', link: '/politica-de-privacidade' },
                       { label: 'Termos e Condições', link: '/termos-e-condicoes' }
                   ];
                   if (settings.footer_menu_2 && settings.footer_menu_2.trim() !== '') {
                       fmenu2 = settings.footer_menu_2.split('\n').filter(line => line.includes('|')).map(line => {
                           const [label, link] = line.split('|');
                           return { label: label.trim(), link: link.trim() };
                       });
                   }
                %>
                <ul>
                    <% fmenu2.forEach(item => { %>
                    <li><a href="<%= item.link %>"><%= item.label %></a></li>
                    <% }); %>
                </ul>
            </div>

            <div class="footer-column">
                <h4>Redes Sociais</h4>
                <div class="social-links" style="display: flex; gap: 15px;">
                    <% 
                        const socialIconsMapFooter = {
                            instagram: 'ri-instagram-line', facebook: 'ri-facebook-fill', linkedin: 'ri-linkedin-fill', 
                            youtube: 'ri-youtube-fill', tiktok: 'ri-tiktok-fill', twitter: 'ri-twitter-x-fill', 
                            pinterest: 'ri-pinterest-fill', google: 'ri-google-fill'
                        };
                        let socialLinksFooter = [];
                        try { socialLinksFooter = JSON.parse(settings.social_links || '[]'); } catch(e) { socialLinksFooter = []; }
                    %>
                    <% socialLinksFooter.forEach(item => { %>
                        <% if (item.network && item.url && socialIconsMapFooter[item.network]) { %>
                            <a href="<%= item.url %>" target="_blank"><i class="<%= socialIconsMapFooter[item.network] %>"></i></a>
                        <% } %>
                    <% }) %>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div style="opacity: 0.82;">
                <% if (settings.cnpj) { %>CNPJ: <%= settings.cnpj %> | <% } %>
                <%= settings.site_name || 'Sua Empresa' %> <%= new Date().getFullYear() %> | <%= settings.footer_text || 'Todos os direitos reservados.' %>
            </div>
            <div style="opacity: 0.78; font-size: 0.65rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase;">
                <a href="https://agenciaetodavia.com.br" target="_blank" style="color: inherit; text-decoration: none; display: flex; align-items: center; gap: 6px;">
                    <i class="ri-shield-check-line" style="color: var(--accent-red);"></i> Website produzido exclusivamente pela E-TODAVIA Agência Criativa Ltda - CNPJ 52.594.366/0001-30
                </a>
            </div>
        </div>
    </div>
</footer>

<!-- Barra LGPD -->
<div id="lgpd-bar" class="lgpd-bar">
    <div class="lgpd-text">
        Utilizamos cookies e tecnologias semelhantes para melhorar sua experiência em nosso site. Ao continuar navegando, você concorda com nossa <a href="/politica-de-privacidade" style="color: var(--navy-blue); font-weight: 700;">Política de Privacidade</a>.
    </div>
    <button class="lgpd-btn" onclick="acceptLGPD()">ACEITAR</button>
</div>

<button type="button" id="lgpd-tab" class="lgpd-tab" onclick="openLGPD()" aria-label="Abrir aviso de cookies">
    Cookies
</button>

<div id="lgpd-modal" class="lgpd-modal" aria-hidden="true">
    <div class="lgpd-modal-card" role="dialog" aria-modal="true" aria-labelledby="lgpd-modal-title">
        <h3 id="lgpd-modal-title">Privacidade e cookies</h3>
        <p>Utilizamos cookies e tecnologias semelhantes para melhorar sua experiência em nosso site. Ao continuar navegando, você concorda com nossa <a href="/politica-de-privacidade">Política de Privacidade</a>.</p>
        <div class="lgpd-modal-actions">
            <button type="button" class="lgpd-btn" onclick="acceptLGPD()">ACEITAR</button>
            <button type="button" class="lgpd-secondary-btn" onclick="closeLGPD()">Agora não</button>
        </div>
    </div>
</div>


<!-- BOTÃO WHATSAPP FLUTUANTE -->
<a href="https://wa.me/<%= settings.whatsapp %>?text=<%= encodeURIComponent(settings.whatsapp_message || 'Olá, estive no site e gostaria de agendar uma consulta.') %>" 
   class="whatsapp-float-btn btn-whatsapp-conversion" target="_blank" aria-label="Fale conosco no WhatsApp">
    <i class="ri-whatsapp-line"></i>
</a>

<script>
    function openLGPD() {
        const modal = document.getElementById('lgpd-modal');
        if (modal) {
            modal.classList.add('show');
            modal.setAttribute('aria-hidden', 'false');
        }
    }

    function closeLGPD() {
        const modal = document.getElementById('lgpd-modal');
        if (modal) {
            modal.classList.remove('show');
            modal.setAttribute('aria-hidden', 'true');
        }
    }

    function acceptLGPD() {
        localStorage.setItem('lgpd_accepted', 'true');
        const bar = document.getElementById('lgpd-bar');
        const tab = document.getElementById('lgpd-tab');
        if (bar) bar.classList.remove('show');
        if (tab) tab.classList.remove('show');
        closeLGPD();
    }

    window.addEventListener('DOMContentLoaded', () => {
        if (!localStorage.getItem('lgpd_accepted')) {
            setTimeout(() => {
                const bar = document.getElementById('lgpd-bar');
                const tab = document.getElementById('lgpd-tab');
                if(bar) bar.classList.add('show');
                if(tab) tab.classList.add('show');
            }, 1000);
        }
    });
</script>
